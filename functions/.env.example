# functions/.env (never commit this)
# Hasura admin secret (from nhost dashboard)
HASURA_GRAPHQL_ENDPOINT=https://your-project-subdomain.hasura.your-region.nhost.run/v1/graphql
HASURA_ADMIN_SECRET=your-hasura-admin-secret

# LLM API — Groq (https://console.groq.com — free tier)
LLM_API_KEY=your-groq-api-key
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# Event trigger secret (shared between Hasura and functions)
HASURA_EVENT_SECRET=your-random-secret-string

# App URL (for LLM referrer headers)
APP_URL=https://your-vercel-app.vercel.app
